{
  "$schema": "https://raw.githubusercontent.com/neutralinojs/neutralinojs/main/schemas/neutralino.config.schema.json",
  "applicationId": "com.geletkatech.makergenerators",
  "applicationName": "3D Maker Generators",
  "author": "Geletka Tech",
  "description": "3D Maker Generators",
  "copyright": "Geletka Tech",
  "version": "1.7.3",
  "defaultMode": "window",
  "port": 0,
  "documentRoot": "/resources/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "tokenSecurity": "one-time",
  "dataLocation": "system",
  "logging": {
    "enabled": false,
    "writeToLogFile": false
  },
  "nativeAllowList": [
    "app.exit",
    "os.showSaveDialog",
    "os.open",
    "os.getPath",
    "filesystem.writeBinaryFile",
    "storage.*",
    "window.*"
  ],
  "modes": {
    "window": {
      "title": "3D Maker Generators",
      "width": 1440,
      "height": 920,
      "minWidth": 900,
      "minHeight": 620,
      "center": true,
      "fullScreen": false,
      "alwaysOnTop": false,
      "icon": "/resources/icons/appIcon.png",
      "enableInspector": false,
      "borderless": false,
      "maximize": false,
      "hidden": false,
      "resizable": true,
      "exitProcessOnClose": true
    }
  },
  "cli": {
    "binaryName": "MakerGenerators",
    "resourcesPath": "/resources/",
    "extensionsPath": "/extensions/",
    "clientLibrary": "/resources/js/neutralino.js",
    "binaryVersion": "6.10.0",
    "clientVersion": "6.10.0"
  }
}